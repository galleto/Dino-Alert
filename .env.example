# ==========================================
# Dino Alert - Environment Configuration
# ==========================================

# Base de datos (TimescaleDB / PostgreSQL)
# Local: postgresql://dinoalert:dinoalert@localhost:5432/dinoalert
# Docker: postgresql://dinoalert:dinoalert@db:5432/dinoalert
DATABASE_URL=postgresql://dinoalert:dinoalert@localhost:5432/dinoalert

# API y Servidor
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKER_INTERVAL_S=5

# Seguridad (opcional, si está vacío la API de escritura es pública)
ACCESS_CODE=

# Evaluación (solo para labels.py)
EVAL_USE_SOLUCION=false

# Frontend / Dominio
VITE_API_URL=http://localhost:8000
DOMAIN=localhost

# Integraciones de IA y Servicios Externos (Opcionales - funcionan desactivadas)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOZ_UMBRAL=0.8

# Solana (Opcional - solo para firma y auditoría en devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_KEYPAIR=
SOLANA_LLAVE_MAESTRA_MINT=

# Backboard (Opcional - memoria de incidentes)
BACKBOARD_API_KEY=

# Vultr Object Storage (Opcional - almacenamiento de zips y audios)
VULTR_S3_ENDPOINT=
VULTR_S3_KEY=
VULTR_S3_SECRET=
VULTR_S3_BUCKET=
